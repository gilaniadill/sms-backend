# Set default behavior to automatically normalize line endings
* text=auto

# Declare file types that should always have LF endings
*.ts      text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Images and binaries - do not modify
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary

# Ignore compiled files
dist/**   binary
node_modules/** binary